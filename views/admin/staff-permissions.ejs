<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>صلاحيات موظفي العيادات | Super Admin</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/admin/header') %>
    
    <main class="page-shell" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
          <div>
            <span class="badge badge-soft mb-2">Clinic Staff Access</span>
            <h1 class="fw-bold fs-2 mb-2">صلاحيات موظفي العيادات</h1>
            <p class="text-secondary mb-0">
              مراجعة صلاحيات الموظفين عبر كل العيادات، مع تدخل Super Admin عند
              الضرورة.
            </p>
          </div>
          <a class="btn btn-primary" href="users"><i class="bi bi-person-plus"></i>إضافة موظف</a>
        </div>
        <div class="filter-panel mb-4">
          <div class="row g-3">
            <div class="col-lg-4">
              <input class="form-control" id="staffPermissionSearch" placeholder="الموظف أو العيادة..." value="" data-ui-unbound-control="" name="staff_permission_search" form="backend-form-8">
            </div>
            <div class="col-lg-3">
              <select class="form-select" id="staffPermissionClinic" data-record-select="clinic" name="staff_permission_clinic" form="backend-form-8"><option value="" selected>كل العيادات</option><option value="C-008" data-record-option="clinic">عيادة الابتسامة الحديثة</option></select>
            </div>
            <div class="col-lg-3">
              <select class="form-select" id="staffPermissionRole" name="staff_permission_role" form="backend-form-8">
                <option value="" selected>كل الأدوار</option>
                <option>منسق استقبال</option>
                <option>محاسب</option>
                <option>منسق عيادة</option>
              </select>
            </div>
          </div>
        </div>
        <div class="table-responsive mobile-stack-wrapper table-ui-shell">
          <table class="table align-middle mb-0 medium-data-table responsive-stack-table system-data-table">
            <thead>
              <tr>
                <th>الموظف</th>
                <th>العيادة</th>
                <th>الدور</th>
                <th>الصلاحيات الفعالة</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
              </tr>
            </thead>
            <tbody>
              <tr data-permission-row="" data-search="سارة أحمد C-008 staff@example.test" data-status="active">
                <td data-label="الموظف" class="table-primary-cell">سارة أحمد — U-U-STAFF-001</td>
                <td data-label="العيادة">عيادة الابتسامة الحديثة</td>
                <td data-label="الدور">منسق عيادة</td>
                <td data-label="الصلاحيات الفعالة" class="table-status-cell">
                  <span class="badge badge-soft">8 صلاحيات</span>
                </td>
                <td data-label="الحالة" class="table-status-cell">
                  <span class="badge text-bg-success">فعال</span>
                </td>
                <td data-label="الإجراءات" class="table-actions-cell">
                  <div class="d-flex gap-1 table-action-grid">
                    <button class="btn btn-sm btn-outline-primary" data-edit-staff-permissions="نور علي" data-ui-open="#staffPermissionsModal" type="button">
                      الصلاحيات</button><button class="btn btn-sm btn-outline-success" data-active-status-text="فعال" data-inactive-status-text="معلق" data-reactivate-label="إلغاء التعليق" data-sensitive-action="reactivate" data-sensitive-entity="U-STAFF-001" data-sensitive-title="إلغاء تعليق الموظف" data-suspend-label="تعليق" type="button" data-ui-open="#sensitiveActionModal">
                      إلغاء التعليق</button><button class="btn btn-sm btn-outline-danger" data-sensitive-action="delete" data-sensitive-entity="U-STAFF-001" data-sensitive-title="حذف حساب الموظف نهائيًا" type="button" data-ui-open="#sensitiveActionModal">
                      حذف نهائي
                    </button>
                  </div>
                </td>
              </tr>
              
            </tbody>
          </table>
        </div>
      </section>
      <div class="modal fade" id="staffPermissionsModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
          <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
              <div>
                <h5 class="modal-title fw-bold">صلاحيات الموظف</h5>
                <small class="text-secondary" id="staffPermissionsName"></small>
              </div>
              <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
              <div class="row g-2">
                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100"><input checked class="form-check-input ms-2" type="checkbox" id="field-1" name="field_1" form="backend-form-9">عرض المواعيد</label>
                </div>
                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100"><input checked class="form-check-input ms-2" type="checkbox" id="field-2" name="field_2" form="backend-form-9">إدارة المواعيد</label>
                </div>
                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100"><input checked class="form-check-input ms-2" type="checkbox" id="field-3" name="field_3" form="backend-form-9">عرض المرضى الإداري</label>
                </div>
                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100"><input checked class="form-check-input ms-2" type="checkbox" id="field-4" name="field_4" form="backend-form-9">إضافة مريض</label>
                </div>
                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100"><input checked class="form-check-input ms-2" type="checkbox" id="field-5" name="field_5" form="backend-form-9">عرض الفواتير</label>
                </div>
                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100"><input checked class="form-check-input ms-2" type="checkbox" id="field-6" name="field_6" form="backend-form-9">تسجيل دفعات</label>
                </div>

                <div class="col-md-6">
                  <label class="border rounded-3 p-3 w-100 text-muted"><input class="form-check-input ms-2" disabled type="checkbox" id="field-7" name="field_7" form="backend-form-9">التشخيص والوصفات — غير متاح لموظفي العيادة</label>
                </div>
              </div>
              <label class="form-label mt-3">سبب تعديل الصلاحيات *</label><textarea class="form-control" id="staffPermissionReason" rows="3" name="staff_permission_reason" form="backend-form-9"></textarea>
            </div>
            <div class="modal-footer">
              <button class="btn btn-light" data-bs-dismiss="modal" type="button">
                إلغاء</button><button class="btn btn-primary" id="saveStaffPermissions" data-ui-pending="" form="backend-form-9" type="submit">
                حفظ الصلاحيات
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
    <div class="modal fade" id="viewModal" tabindex="-1">
      <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold" id="viewTitle"></h5>
              <small class="text-secondary" id="viewSubtitle"></small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body" id="viewBody"></div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إغلاق</button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="sensitiveActionModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold" id="sensitiveActionTitle">
                تأكيد إجراء إداري
              </h5>
              <small class="text-secondary" id="sensitiveActionSubtitle"></small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body">
            <div class="alert alert-warning rounded-4">
              <i class="bi bi-shield-exclamation ms-1"></i>هذا إجراء حساس،
              وسبب الإجراء مطلوب لتوضيح سبب التغيير الإداري.
            </div>
            <label class="form-label">سبب الإجراء الإداري *</label><textarea class="form-control" id="sensitiveActionReason" placeholder="اكتب سببًا واضحًا..." rows="4" name="sensitive_action_reason" form="backend-form-10"></textarea>
          </div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" id="confirmSensitiveAction" data-ui-pending="" form="backend-form-10" type="submit">
              تأكيد
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


