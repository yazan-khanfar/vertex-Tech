<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>تفاصيل الوظيفة | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/admin/header') %>
    
    <main class="page-shell" id="main-content">
      <section class="container py-4 py-lg-5">
        <nav>
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="doctors#jobsTab">وظائف الأطباء</a>
            </li>
            <li class="breadcrumb-item active" id="detailJobBreadcrumb">
              J-101
            </li>
          </ol>
        </nav>
        <div class="d-flex justify-content-between gap-3 flex-wrap mb-4">
          <div>
            <span class="badge text-bg-success mb-2" id="detailJobStatusBadge">منشور</span>
            <h1 class="fw-bold fs-2" id="detailJobTitle">
              طبيب أسنان عام — J-101
            </h1>
            <p class="text-secondary mb-0" id="detailJobSubtitle">
              عيادة الابتسامة الحديثة • نابلس
            </p>
          </div>
          <button class="btn btn-outline-danger" data-current-detail-action="" data-sensitive-action="archive" data-sensitive-entity="J-101" data-sensitive-redirect="doctors#jobsTab" data-sensitive-title="أرشفة الوظيفة مع حفظ الطلبات" data-ui-open="#sensitiveActionModal" type="button">أرشفة الوظيفة</button>
        </div>
        <div class="soft-card p-4 mb-4">
          <h4 class="fw-bold mb-3">تفاصيل الوظيفة</h4>
          <div class="summary-row">
            <span>العيادة</span><a href="clinic-details?id=C-008" id="detailJobClinic">عيادة الابتسامة الحديثة</a>
          </div>
          <div class="summary-row">
            <span>التخصص</span><strong id="detailJobSpecialty">طب أسنان عام</strong>
          </div>
          <div class="summary-row">
            <span>الدوام</span><strong id="detailJobType">دوام كامل</strong>
          </div>
          <div class="summary-row">
            <span>القرار الطبيعي</span><strong>مدير العيادة يقبل/يرفض؛ Super Admin يتدخل استثنائيًا فقط</strong>
          </div>
        </div>
        <div class="soft-card table-responsive mobile-stack-wrapper table-ui-shell">
          <table class="table mb-0 admin-master-table responsive-stack-table system-data-table">
            <thead>
              <tr>
                <th>الطلب</th>
                <th>الطبيب</th>
                <th>التخصص</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
              </tr>
            </thead>
            <tbody id="detailJobApplicantsBody">
              <tr>
                <td data-label="الطلب" class="table-primary-cell">JA-001</td>
                <td data-label="الطبيب">د. عمر ناصر</td>
                <td data-label="التخصص">طب أسنان عام</td>
                <td data-label="الحالة" class="table-status-cell"><span class="badge text-bg-secondary">مقبول</span></td>
                <td data-label="الإجراءات" class="table-actions-cell">
                  <a class="btn btn-sm btn-outline-primary" href="job-application-details?id=JA-204">فتح</a>
                </td>
              </tr>
              
            </tbody>
          </table>
        </div>
      </section>
    </main>
    <div class="modal fade" id="viewModal" tabindex="-1">
      <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold" id="viewTitle"></h5>
              <small class="text-secondary" id="viewSubtitle"></small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body" id="viewBody"></div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إغلاق</button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="sensitiveActionModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold" id="sensitiveActionTitle">
                تأكيد إجراء إداري
              </h5>
              <small class="text-secondary" id="sensitiveActionSubtitle"></small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body">
            <div class="alert alert-warning rounded-4">
              <i class="bi bi-shield-exclamation ms-1"></i>هذا إجراء حساس،
              وسبب الإجراء مطلوب لتوضيح سبب التغيير الإداري.
            </div>
            <label class="form-label">سبب الإجراء الإداري *</label><textarea class="form-control" id="sensitiveActionReason" placeholder="اكتب سببًا واضحًا..." rows="4" name="sensitive_action_reason" form="backend-form-1"></textarea>
          </div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" id="confirmSensitiveAction" data-ui-pending="" form="backend-form-1" type="submit">
              تأكيد
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="modal fade" id="relatedEntityEditModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 rounded-4"><div class="modal-header"><div><h5 class="modal-title fw-bold" id="relatedEntityEditTitle">تعديل عنصر</h5><small class="text-secondary" id="relatedEntityEditCode"></small></div><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><label class="form-label">القيمة / الاسم</label><input class="form-control" id="relatedEntityEditValue" value="" name="related_entity_edit_value" form="backend-form-2"><label class="form-label mt-3">سبب التعديل الإداري *</label><textarea class="form-control" id="relatedEntityEditReason" rows="3" name="related_entity_edit_reason" form="backend-form-2"></textarea></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" id="saveRelatedEntityEdit" data-ui-pending="" form="backend-form-2" type="submit">حفظ</button></div></div></div></div><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-1" method="post" data-ui-unbound="" data-backend-binding="modal" hidden=""></form><form id="backend-form-2" method="post" data-ui-unbound="" data-backend-binding="modal" hidden=""></form><%- include('../partials/admin/footer') %></body></html>