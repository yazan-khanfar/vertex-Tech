                    <div class="form-check form-switch">
                      <input checked class="form-check-input" type="checkbox" id="field-20" name="field_20" form="backend-form-31">
                    </div>
                  </div>
                  <%- include('../partials/shared/active-sessions', {sessionsScope:'admin'}) %>
                </div>
                <div class="soft-card p-4" id="sdc-password">
                  <h4 class="fw-bold mb-3">كلمة المرور</h4><% if (typeof passwordChangeError !== "undefined" && passwordChangeError) { %><div class="alert alert-danger mt-2" role="alert" id="sdc-password"><%= passwordChangeError %><% if (typeof passwordChangeReference !== "undefined" && passwordChangeReference) { %> <small>(رمز التشخيص: <%= passwordChangeReference %>)</small><% } %></div><% } %>

                  <p class="text-secondary">لحماية حسابك، سيُنهي تغيير كلمة المرور جميع الجلسات ويطلب تسجيل الدخول من جديد.</p>
                  <button class="btn btn-outline-primary" data-bs-target="#passwordModal" data-bs-toggle="modal" type="button">
                    تغيير كلمة المرور
                  </button>
                </div>
              </div>
              <div class="tab-pane fade" id="account" role="tabpanel" aria-labelledby="settings-account-tab" tabindex="0">
                <div class="soft-card p-4">
                  <div class="settings-section-head">
                    <span class="icon-box"><i class="bi bi-person-gear"></i></span>
                    <div>
                      <h4 class="fw-bold mb-1">حساب Super Admin</h4>
                      <small class="text-secondary">يوجد حساب Super Admin واحد فقط في النظام.</small>
                    </div>
                  </div>
