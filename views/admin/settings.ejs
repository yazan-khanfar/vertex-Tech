                    <div class="col-md-6">
                      <label class="form-label" for="field-21">اسم المدير</label><input class="form-control" value="مدير النظام" id="field-21" name="field_21" form="backend-form-32">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label" for="field-22">البريد</label><input class="form-control" value="admin@example.test" id="field-22" name="field_22" form="backend-form-32">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label" for="field-23">الهاتف</label><input class="form-control" value="0599 000 001" id="field-23" name="phone" form="backend-form-32">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label" for="field-24">الحالة</label><input class="form-control" readonly value="Active" id="field-24" name="status" form="backend-form-32">
                    </div>
                  </div>
                  <button class="btn btn-primary mt-4" data-temp-save="تم حفظ بيانات حساب Super Admin مؤقتًا" data-ui-pending="" form="backend-form-32" type="submit">
                    حفظ بيانات الحساب
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <div class="modal fade" id="passwordModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
              <h5 class="modal-title fw-bold">تغيير كلمة المرور</h5>
              <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
              <label class="form-label" for="field-25">كلمة المرور الحالية</label><input class="form-control mb-3" type="password" required value="" id="field-25" name="current_password" autocomplete="current-password" form="sdc-change-password-form"><label class="form-label">كلمة المرور الجديدة</label><input class="form-control mb-3" id="newAdminPassword" type="password" minlength="14" maxlength="128" required value="" name="new_password" autocomplete="new-password" form="sdc-change-password-form"><label class="form-label">تأكيد كلمة المرور</label><input class="form-control" id="confirmAdminPassword" type="password" minlength="14" maxlength="128" required value="" name="confirm_password" autocomplete="new-password" form="sdc-change-password-form">
            </div>
            <div class="modal-footer">
              <button class="btn btn-light" data-bs-dismiss="modal" type="button">
                إلغاء</button><button class="btn btn-primary" id="savePasswordBtn" form="sdc-change-password-form" type="submit">
                تغيير
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
    <div class="modal fade" id="viewModal" tabindex="-1">
      <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold" id="viewTitle"></h5>
              <small class="text-secondary" id="viewSubtitle"></small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body" id="viewBody"></div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إغلاق</button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="sensitiveActionModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold" id="sensitiveActionTitle">
                تأكيد إجراء إداري
              </h5>
              <small class="text-secondary" id="sensitiveActionSubtitle"></small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body">
            <div class="alert alert-warning rounded-4">
              <i class="bi bi-shield-exclamation ms-1"></i>هذا إجراء حساس،
              وسبب الإجراء مطلوب لتوضيح سبب التغيير الإداري.
            </div>
            <label class="form-label">سبب الإجراء الإداري *</label><textarea class="form-control" id="sensitiveActionReason" placeholder="اكتب سببًا واضحًا..." rows="4" name="sensitive_action_reason" form="backend-form-34"></textarea>
          </div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" id="confirmSensitiveAction" data-ui-pending="" form="backend-form-34" type="submit">
              تأكيد
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
