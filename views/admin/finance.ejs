                    <div class="col-md-4">
                      <label class="form-label small text-secondary mb-1">من تاريخ</label><input class="form-control" id="financeFromDate" type="date" value="2026-10-21" name="finance_from_date" form="backend-form-1">
                    </div>
                    <div class="col-md-4">
                      <label class="form-label small text-secondary mb-1">إلى تاريخ</label><input class="form-control" id="financeToDate" type="date" value="2026-10-21" name="finance_to_date" form="backend-form-1">
                    </div>
                    <div class="col-md-4">
                      <button class="btn btn-primary w-100" id="applyFinanceCustomDates" type="button" data-ui-pending="">
