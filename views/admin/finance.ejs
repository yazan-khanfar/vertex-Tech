              تسويات العيادات
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-target="#invoices" data-bs-toggle="pill" aria-selected="false" tabindex="-1" role="tab" type="button">
              فواتير المرضى
            </button>
          </li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane fade show active" id="settlements" role="tabpanel">
            <div class="filter-panel mb-4">
