            <div class="stat-card">
              <small class="text-secondary">المطلوب للمنصة</small>
              <div class="stat-value" id="financeTotalDue">25 ₪</div>
              <small>عن الفترات المعروضة</small>
            </div>
          </div>
          <div class="col-6 col-xl-3">
            <div class="stat-card">
              <small class="text-secondary">تم استلامه</small>
              <div class="stat-value text-success" id="financeTotalReceived">0 ₪</div>
              <small>دفعات العيادات</small>
            </div>
          </div>
          <div class="col-6 col-xl-3">
            <div class="stat-card">
              <small class="text-secondary">المتبقي</small>
              <div class="stat-value text-danger" id="financeTotalRemaining">25 ₪</div>
              <small>ما زال على العيادات</small>
            </div>
          </div>
          <div class="col-6 col-xl-3">
            <div class="stat-card">
              <small class="text-secondary">عيادات مسددة</small>
              <div class="stat-value" id="financePaidClinics">0</div>
              <small>من 4 سجلات</small>
            </div>
          </div>
        </div>
        <ul class="nav admin-tabs mb-4" role="tablist">
