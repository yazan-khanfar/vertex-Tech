                <div class="col-lg-4">
                  <input class="form-control" id="financeSearch" placeholder="ابحث باسم العيادة..." value="" data-ui-unbound-control="" name="finance_search" form="backend-form-1">
                </div>
                <div class="col-md-4 col-lg-3">
                  <select class="form-select" id="financeStatus" name="finance_status" form="backend-form-1">
                    <option value="" selected>كل الحالات</option>
                    <option value="remaining">عليها مبلغ متبقي</option>
                    <option value="paid">مسددة</option>
                    <option value="unpaid">لم تدفع بعد</option>
                  </select>
                </div>
                <div class="col-md-4 col-lg-3">
                  <select class="form-select" id="financePeriod" name="finance_period" form="backend-form-1">
                    <option value="" selected>كل الفترات</option>
                    <option value="2026-10">أكتوبر 2026</option>
                    <option value="2026-09">سبتمبر 2026</option>
                    <option value="custom">فترة مخصصة</option>
                  </select>
                </div>
                <div class="col-12 d-none" id="financeCustomDates">
