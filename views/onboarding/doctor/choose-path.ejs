<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>اختيار مسار الطبيب | Smart Dental Clinic</title>
    <link href="../../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="../assets/styles.css">
  <link href="../../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body>
    <div class="auth-page">
      <div class="container">
        <div class="auth-card mx-auto" style="max-width: 900px">
          <div class="auth-form-wrap">
            <div class="text-center">
              <span class="hero-badge"><i class="bi bi-check-circle"></i>تم إنشاء حساب الطبيب</span>
              <h1 class="mt-3 mb-2">ما الخطوة التالية؟</h1>
              <p>
                اختر مسارك. لن تدخل لوحة الطبيب الكاملة إلا بعد اعتماد إنشاء
                العيادة أو قبولك في وظيفة.
              </p>
            </div>
            <div class="row g-4 mt-2">
              <div class="col-md-6">
                <a class="path-card d-block" href="clinic/create"><i class="bi bi-hospital"></i>
                  <h3>إنشاء عيادة</h3>
                  <p>
                    قدّم بيانات عيادتك ووثائقها لإرسالها إلى Super Admin
                    للمراجعة والاعتماد.
                  </p>
                  <span class="btn btn-outline-primary btn-sm mt-3">بدء الطلب</span></a>
              </div>
              <div class="col-md-6">
                <a class="path-card d-block" href="jobs/index"><i class="bi bi-briefcase"></i>
                  <h3>التقدم إلى وظيفة</h3>
                  <p>
                    تقدم إلى وظيفة منشورة من إحدى العيادات، وبعد قبولك تُكمل العيادة ربط
                    حسابك وتحديد الخدمات والدوام قبل بدء العمل.
                  </p>
                  <span class="btn btn-outline-primary btn-sm mt-3">عرض الوظائف</span></a>
              </div>
            </div>
            <div class="border rounded-3 p-3 p-md-4 mt-4 bg-light">
              <h2 class="h5 mb-2"><i class="bi bi-person-circle ms-2"></i>حسابك الشخصي</h2>
              <p class="text-secondary small mb-3">مرحبًا <strong><%= currentUser.fullName %></strong>، يمكنك الاطلاع على معلومات حسابك وتفعيل التحقق بخطوتين دون انتظار الانضمام إلى عيادة.</p>
              <div class="d-flex justify-content-center flex-wrap gap-2">
                <a class="btn btn-outline-primary" href="/doctor/profile"><i class="bi bi-person ms-2"></i>معلومات حسابي</a>
                <a class="btn btn-outline-primary" href="/doctor/profile#sdc-mfa"><i class="bi bi-shield-lock ms-2"></i>إعدادات الأمان وMFA</a>
              </div>
            </div>
            <div class="text-center mt-4">
              <form action="/auth/logout" method="post"><input type="hidden" name="csrf_token" value="<%= logoutCsrf %>"><button class="btn btn-link small text-secondary" type="submit">تسجيل الخروج والعودة لاحقًا</button></form>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="../../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="../assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div>
        <!-- زر الدعم الفني العائم -->
        <a class="floating-chat-btn" href="/account/support" title="فتح طلب دعم فني"><i class="bi bi-chat-dots-fill"></i></a>

        <!-- نافذة الشات المنبثقة -->
        
    </div><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div></body></html>