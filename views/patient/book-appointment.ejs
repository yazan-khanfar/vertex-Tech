<!DOCTYPE html>
<html data-style-sections="section-6" dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>إكمال الحجز | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/patient/header') %>
    
    <main class="page-shell" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="row justify-content-center">
          <div class="col-xl-9">
            <% const clinicChoice=rows.find(r=>r.clinic_id===selection.clinic_id); %>
            <% const doctorChoice=rows.find(r=>r.clinic_id===selection.clinic_id&&r.doctor_id===selection.doctor_id); %>
            <% const hasClinicDoctor=Boolean(clinicChoice&&doctorChoice); %>
            <% const availableServices=[...new Map(rows.filter(r=>r.clinic_id===selection.clinic_id&&r.doctor_id===selection.doctor_id).map(r=>[r.service_id,r])).values()]; %>
            <div class="mb-4">
              <span class="badge badge-soft mb-2">Appointment</span>
              <h1 class="fw-bold">إكمال الحجز</h1>
              <p class="text-secondary mb-0">
                العيادة والطبيب تم اختيارهما مسبقاً. تظهر فقط الأوقات التي يسمح
                بها جدول دوام الطبيب وتوفر العيادة.
              </p>
            </div>
            <% if(message){ %><div class="alert alert-warning border-0 rounded-4" role="alert"><%= message %></div><% } %>
            <!-- يبقى سياق المتابعة والمساعد في التصميم، لكن لا نعرض نجاحاً تجريبياً. -->
            <div class="alert alert-primary border-0 rounded-4 d-none" id="followupBookingContext">
              <i class="bi bi-arrow-repeat ms-2"></i><strong>حجز متابعة:</strong> تم فتح الحجز من توصية الطبيب. اختر وقتاً متاحاً من جدول الطبيب.
            </div>
            <div class="alert alert-info border-0 rounded-4 d-none" id="aiBookingContext">
              <i class="bi bi-stars ms-2"></i><strong>حجز مقترح بواسطة المساعد الذكي.</strong>
              سيتم إعادة فحص التوفر قبل تأكيد الحجز. <div class="small mt-2" id="aiBookingMeta"></div>
            </div>
            <!-- نموذج للبحث عن الأوقات فقط: لا ينشئ حجزاً -->
            <form id="bookingCatalogForm" method="get" action="/patient/book-appointment"></form>
            <!-- نفس بطاقة اختيار العيادة والطبيب الموجودة في التصميم الأصلي -->
            <div class="soft-card p-4 mb-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <small class="text-secondary">العيادة المختارة</small>
                  <div class="fw-bold fs-5" id="selectedClinicName"><%= clinicChoice?clinicChoice.clinic_name:'اختر عيادة' %></div>
                </div>
                <div class="col-md-6">
                  <small class="text-secondary">الطبيب المختار</small>
                  <div class="fw-bold fs-5" id="selectedDoctorName"><%= doctorChoice?'د. '+doctorChoice.doctor_name:'اختر طبيبًا' %></div>
                </div>
              </div>
              <% if(hasClinicDoctor){ %>
                <button class="btn btn-link btn-sm text-decoration-none p-0 mt-3" type="button"
                  data-bs-toggle="collapse" data-bs-target="#bookingChangeSelection" aria-expanded="false"
                  aria-controls="bookingChangeSelection">تغيير العيادة أو الطبيب</button>
              <% } %>
              <div id="bookingChangeSelection" class="collapse <%= hasClinicDoctor?'':'show' %>">
                <div class="row g-3 mt-1">
                  <div class="col-md-6">
                    <label class="form-label fw-bold" for="bookingClinicSelect">العيادة</label>
                    <select class="form-select" id="bookingClinicSelect" name="clinic_id" form="bookingCatalogForm" required>
                      <option value="">اختر العيادة</option>
                      <% for(const c of [...new Map(rows.map(r=>[r.clinic_id,r])).values()]){ %>
                        <option value="<%= c.clinic_id %>" <%= selection.clinic_id===c.clinic_id?'selected':'' %>><%= c.clinic_name %></option>
                      <% } %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold" for="bookingDoctorSelect">الطبيب</label>
                    <select class="form-select" id="bookingDoctorSelect" name="doctor_id" form="bookingCatalogForm" required>
                      <option value="">اختر الطبيب</option>
                      <% for(const d of [...new Map(rows.map(r=>[r.clinic_id+':'+r.doctor_id,r])).values()]){ %>
                        <option value="<%= d.doctor_id %>" data-clinic-id="<%= d.clinic_id %>" <%= selection.clinic_id===d.clinic_id&&selection.doctor_id===d.doctor_id?'selected':'' %>>د. <%= d.doctor_name %></option>
                      <% } %>
                    </select>
                  </div>
                  <div class="col-12">
                    <button type="submit" form="bookingCatalogForm" formnovalidate class="btn btn-outline-primary btn-sm">تحديث الخدمات المتاحة</button>
                  </div>
                </div>
              </div>
              <% if(!rows.length){ %><div class="text-secondary small mt-3">لا توجد عيادات وأطباء مع خدمات متاحة للحجز الإلكتروني حاليًا.</div><% } %>
            </div>
            <!-- نفس بطاقة الخدمة والتاريخ والأوقات والملاحظات الأصلية -->
            <div class="soft-card p-4 p-lg-5">
              <div class="row g-4">
                <div class="col-md-6">
                  <label class="form-label fw-bold" for="serviceSelect">الخدمة</label>
                  <select class="form-select" id="serviceSelect" name="service_id" form="bookingCatalogForm" required>
                    <option value="">اختر الخدمة</option>
                    <% for(const item of availableServices){ %>
                      <option value="<%= item.service_id %>" <%= selection.service_id===item.service_id?'selected':'' %>><%= item.service_name %> — <%= item.price %> ₪ — <%= item.duration %> دقيقة</option>
                    <% } %>
                  </select>
                  <div class="small text-secondary mt-2">خدمات هذه العيادة المخصصة للطبيب المختار فقط؛ السعر والمدة من كتالوج العيادة.</div>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold" for="bookingDate">التاريخ</label>
                  <input class="form-control" id="bookingDate" type="date" min="<%= now.date %>"
                    value="<%= selection.appointment_date %>" name="appointment_date" form="bookingCatalogForm" required>
                </div>
                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">الأوقات</label>
                    <div class="small text-secondary">
                      <span class="me-3"><i class="bi bi-circle-fill text-primary small"></i> متاح</span>
                      <span><i class="bi bi-dash-circle text-secondary"></i> غير متاح</span>
                    </div>
                  </div>
                  <div aria-live="polite" class="slot-grid" data-slot-display="all" id="timeSlots">
                    <% if(selected&&selection.appointment_date&&timeSlots.length){ %>
                      <% for(const t of timeSlots){ %>
                        <div class="slot-choice">
                          <input class="visually-hidden" type="radio" id="slot-<%= t.replace(':','-') %>"
                            name="appointment_time" value="<%= t %>" form="backend-form-1" required>
                          <label class="time-slot available btn btn-light w-100" for="slot-<%= t.replace(':','-') %>"><%= t %></label>
                        </div>
                      <% } %>
                    <% }else{ %>
                      <div class="alert alert-info border-0 rounded-3 w-100 mb-0">
                        <%= availabilityMessage || (selected&&selection.appointment_date?'لا توجد أوقات متاحة بهذا التاريخ. اختر تاريخًا آخر.':'اختر الخدمة والتاريخ ثم اضغط «عرض الأوقات المتاحة».') %>
                      </div>
                    <% } %>
                  </div>
                  <div class="mt-3 small text-secondary" id="bookingState">
                    <%= selected?`${selected.service_name} • ${selected.price} ₪ • ${selected.duration} دقيقة (السعر الحالي، ويحفظ عند الحجز)`:'لن يتم حجز أي وقت قبل تأكيد الطلب.' %>
                  </div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-bold" for="bookingNotes">ملاحظات للطبيب <span class="text-secondary fw-normal">(اختياري)</span></label>
                  <textarea class="form-control" id="bookingNotes" placeholder="مثال: لدي ألم عند المضغ منذ يومين..." rows="4" maxlength="2000" name="notes" form="backend-form-1"></textarea>
                  <div class="form-text">السعر الظاهر في ملخص الحجز هو سعر الخدمة المعروض وقت اختيار الموعد.</div>
                </div>
              </div>
              <div class="d-flex justify-content-end flex-wrap gap-2 mt-4">
                <button type="submit" form="bookingCatalogForm" class="btn btn-outline-primary">عرض الأوقات المتاحة</button>
                <a class="btn btn-light" href="<%= doctorChoice?'/patient/doctor-details?doctor_id='+encodeURIComponent(doctorChoice.doctor_id)+'&clinic_id='+encodeURIComponent(doctorChoice.clinic_id):'/patient/clinics' %>">رجوع</a>
                <button class="btn btn-primary px-4" id="confirmBooking" type="submit" form="backend-form-1"
                  <%= !(selected&&selection.appointment_date&&timeSlots.length)?'disabled':'' %>>تأكيد الحجز</button>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- يُعرض هذا الحوار فقط عند تأكيد الخادم؛ لا توجد عمليات نجاح وهمية. -->
      <div class="modal fade" id="bookingSuccess" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 rounded-4">
          <div class="modal-body p-5 text-center"><div class="icon-box mx-auto mb-3"><i class="bi bi-check2-circle"></i></div>
            <h4 class="fw-bold">تم إرسال الحجز</h4>
            <p class="text-secondary" id="bookingSuccessText">تم اختيار الموعد بنجاح.</p>
            <a class="btn btn-primary w-100" href="/patient/appointments">عرض مواعيدي</a>
          </div>
        </div></div>
      </div>
    </main>
    <%- include('../partials/patient/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-1" method="post" action="/patient/book-appointment" hidden>
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="clinic_id" value="<%= selected?.clinic_id || '' %>"><input type="hidden" name="doctor_id" value="<%= selected?.doctor_id || '' %>"><input type="hidden" name="service_id" value="<%= selected?.service_id || '' %>"><input type="hidden" name="appointment_date" value="<%= selection.appointment_date %>"></form></body></html>