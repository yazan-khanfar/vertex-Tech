<!DOCTYPE html>
<html data-style-sections="section-3" dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>مواعيدي | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
    <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">
    
  
    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <!-- شريط التنقل العلوي -->
    <%- include('../partials/patient/header') %>

    <!-- القائمة الجانبية للموبايل -->
    

    <!-- المحتوى الرئيسي -->
    <main class="page-shell" id="main-content"><section class="container py-4 py-lg-5"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="appointments">مواعيدي</a></li><li class="breadcrumb-item active" aria-current="page">تفاصيل الحجز</li></ol></nav>
    <div class="soft-card p-4 mt-3"><span class="badge text-bg-info mb-2">بيانات الحجز الفعلية</span><h1 class="fw-bold h3 mb-2">تفاصيل الموعد <span id="sdcPatientBookingId"><%= booking.id %></span></h1><p class="text-secondary">تظهر تفاصيل الحجز حسب مصدره وحالته، ولا تعني وجود تقرير طبي معتمد.</p><div id="sdcPatientBookingBody" class="sdc-v19-data-grid mt-3"><div><small>المريض</small><strong><%= booking.patient_name %></strong></div><div><small>الطبيب</small><strong>د. <%= booking.doctor_name %></strong></div><div><small>الخدمة</small><strong><%= booking.service_name %></strong></div><div><small>التاريخ</small><strong><%= booking.date %></strong></div><div><small>الوقت</small><strong><%= booking.time %></strong></div><div><small>المصدر</small><strong><%= booking.source==='manual'?'حجز يدوي':booking.source %></strong></div><div><small>الحالة</small><strong><%= labels[booking.status]||booking.status %></strong></div><div><small>السعر وقت الحجز</small><strong><%= booking.price %> ₪</strong></div></div><% if(booking.status==='rejected' && booking.administrative_notes){ %><div class="alert alert-danger rounded-4 mt-3" role="status"><strong>سبب رفض الموعد:</strong> <%= booking.administrative_notes %></div><% } %><div class="alert alert-info mt-3" id="sdcPatientBookingAI"><% if(booking.request_status==='pending'){ %>يوجد طلب لتغيير الموعد إلى <%= booking.requested_date %> • <%= booking.requested_time %> بانتظار رد العيادة.<% }else{ %>تغيير المواعيد والإلغاء يخضعان لشروط الحجز وحالته، وتُحفظ التعديلات في قاعدة البيانات.<% } %></div><a href="/patient/appointments" class="btn btn-outline-primary mt-3">رجوع لمواعيدي</a><% if(['pending','confirmed'].includes(booking.status)){ %>
 <form class="mt-3" method="post" action="/patient/appointments/action"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="booking_id" value="<%= booking.id %>"><button class="btn btn-outline-danger" type="submit" name="action" value="cancel" onclick="return confirm('هل تريد إلغاء الموعد؟')">إلغاء الموعد</button></form>
 <% if(booking.request_status!=='pending'){ %><form class="mt-3 row g-2" method="post" action="/patient/appointments/action"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="booking_id" value="<%= booking.id %>"><div class="col-md-4"><label class="form-label">التاريخ البديل</label><input class="form-control" type="date" min="<%= now.date %>" name="requested_date" required></div><div class="col-md-3"><label class="form-label">الوقت البديل</label><input class="form-control" type="time" step="1800" name="requested_time" required></div><div class="col-md-5"><label class="form-label">السبب</label><input class="form-control" name="reason" maxlength="2000" required></div><div class="col-12"><button class="btn btn-outline-primary" name="action" value="request_change">إرسال طلب تغيير الموعد</button></div></form><% } %><% } %></div></section></main>
    <%- include('../partials/patient/footer') %>

    <!-- التوست (Toast) -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0 shadow" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>

    <!-- السكريبتات -->
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
    <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>
  

<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div></body></html>