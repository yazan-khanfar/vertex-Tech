me="health_notes" required="" rows="3" placeholder="اكتب المعلومات المعروفة، أو اذكر لا يوجد / غير معروف حسب حالتك"></textarea></div><div class="col-md-4"><label class="form-label" for="firstHealth_signup_allergies">الحساسية *</label><textarea class="form-control" id="firstHealth_signup_allergies" name="allergies" rows="2" placeholder="اكتب المعلومات المعروفة، أو اذكر لا يوجد / غير معروف حسب حالتك" data-multivalue-lines required=""></textarea></div><div class="col-md-4"><label class="form-label" for="firstHealth_signup_chronic_diseases">الأمراض المزمنة *</label><textarea class="form-control" id="firstHealth_signup_chronic_diseases" name="chronic_diseases" rows="2" placeholder="اكتب المعلومات المعروفة، أو اذكر لا يوجد / غير معروف حسب حالتك" data-multivalue-lines required=""></textarea></div><div class="col-md-4"><label class="form-label" for="firstHealth_signup_current_medications">الأدوية الحالية *</label><textarea class="form-control" id="firstHealth_signup_current_medications" name="current_medications" rows="2" placeholder="اكتب المعلومات المعروفة، أو اذكر لا يوجد / غير معروف حسب حالتك" data-multivalue-lines required=""></textarea></div></div><div id="firstHealthProfileError" class="alert alert-danger mt-3 mb-0" role="alert" hidden></div></form></div><div class="modal-footer"><button type="submit" form="firstHealthProfileForm" class="btn btn-primary" id="firstHealthProfileSubmit">حفظ المعلومات والمتابعة</button></div></div></div></div></body></html>