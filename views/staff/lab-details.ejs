<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>حالات المختبر | Clinic Staff</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body data-page-permission="lab_orders.view" data-staff-account-status="active" data-staff-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>" data-staff-user-id="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.userId : '' %>" data-rendered-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-active-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-staff-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : '' %>"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/staff/header') %>
    

    
    <main class="page-shell" data-staff-lab-details-page="" id="main-content" data-staff-workspace=""><div class="container pt-3"><label class="form-label small fw-bold" for="activeClinicContext">العيادة الحالية</label><select class="form-select mb-3" id="activeClinicContext" name="active_clinic_id" data-context-switcher="" aria-describedby="staffClinicContextHelp"><% if(typeof activeClinic !== 'undefined' && activeClinic){ %><option value="<%= activeClinic.id %>" data-membership-status="active" data-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : 'موظف' %>" data-clinic-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>"><%= activeClinic.name %></option><% } %></select><div class="d-flex flex-wrap align-items-center gap-2 mb-2"><a class="btn btn-outline-primary btn-sm" href="choose-clinic" data-choose-clinic-link>اختيار أو تبديل العيادة</a><small class="text-secondary" id="staffClinicContextHelp">تظهر بيانات وصلاحيات العيادة المختارة فقط.</small></div></div><section class="container py-4 py-lg-5" data-clinic-content="">
        <div class="mb-4"><a class="small text-decoration-none" href="lab-cases" data-requires-permission="lab_orders.view"><i class="bi bi-arrow-right ms-1"></i>العودة للمختبرات</a><div class="d-flex align-items-center gap-2 mt-2"><h1 class="fw-bold fs-2 mb-0" id="staffLabDetailName">Elite Dental Lab</h1><span class="badge text-bg-success" id="staffLabDetailStatus">نشط</span></div><p class="text-secondary mt-2 mb-0"><span id="staffLabDetailAddress">نابلس - رفيديا</span> • <span id="staffLabDetailPhone">0599 123 456</span></p></div>
        <div class="filter-panel mb-4"><div class="row g-3"><div class="col-lg-7"><input class="form-control" id="staffLabCaseSearch" placeholder="رقم الحالة أو المريض أو الطبيب" value="" data-ui-unbound-control="" name="staff_lab_case_search" form="backend-form-1"></div><div class="col-lg-5"><select class="form-select" id="staffLabCaseStatus" name="staff_lab_case_status" form="backend-form-1"><option value="all" selected>كل الحالات</option><option value="waiting">بانتظار الإرسال</option><option value="sent">تم الإرسال</option><option value="received">تم الاستلام</option><option value="installed">تم التركيب</option></select></div></div></div>
        <div class="soft-card p-3"><div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 wide-data-table responsive-stack-table system-data-table"><thead><tr><th>الرقم</th><th>المريض</th><th>الطبيب</th><th>العمل</th><th>الحالة</th><th>التسليم المتوقع</th><th>الإجراء</th></tr></thead><tbody>
          <tr data-staff-lab-case="" data-lab="elite" data-status="received" data-search="LAB-001 أحمد خالد عمر" data-record-id="LC-001"><td data-label="الرقم" class="table-primary-cell"><strong>LC-001</strong></td><td data-label="المريض">أحمد خالد</td><td data-label="الطبيب">د. عمر ناصر</td><td data-label="العمل">تاج Zirconia • سن 46</td><td data-label="الحالة" class="table-status-cell"><span class="badge text-bg-success" data-case-status-badge="">تم الاستلام</span></td><td data-label="التسليم المتوقع">21 أكتوبر 2026</td><td data-label="الإجراء" class="table-actions-cell"><button class="btn btn-sm btn-primary" data-requires-permission="lab_orders.update_delivery" data-staff-lab-action="send" data-ui-pending="">تسجيل تم الإرسال</button><button class="btn btn-sm btn-light border" data-requires-permission="lab_orders.update_delivery" data-staff-lab-transfer="" data-ui-pending="">نقل لمختبر</button></td></tr>
          
          
          

          
          
          
          
        </tbody></table></div><div class="text-center p-4 d-none" id="staffLabCasesEmpty">لا توجد حالات مطابقة.</div></div>
      </section><section class="container py-4" id="staffScopeNotice" hidden><div class="soft-card p-4 text-center"><i class="bi bi-building-lock fs-1 text-primary"></i><h3 class="fw-bold mt-3" id="staffScopeTitle">اختر العيادة للمتابعة</h3><p class="text-secondary" id="staffScopeMessage">حدد عيادة لديك عضوية فعّالة فيها لعرض بياناتها وصلاحياتك.</p><a href="choose-clinic" class="btn btn-primary">اختيار العيادة</a></div></section></main>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-1" method="get" data-ui-unbound="" data-backend-binding="filter" hidden=""></form><%- include('../partials/staff/footer') %></body></html>