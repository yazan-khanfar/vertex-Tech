<!DOCTYPE html>
<html data-style-sections="section-5" dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>تفاصيل خطة العلاج | Smart Dental Doctor</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#treatmentPlanDetailPage">تخطي إلى المحتوى</a>
    <%- include('../partials/doctor/header') %>
    
    <main class="page-shell" id="treatmentPlanDetailPage"><section class="container py-4 py-lg-5"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="treatment-plans">خطط العلاج</a></li><li class="breadcrumb-item"><a href="patient-details?id=<%= plan.patient_id %>"><%= plan.patient_name %></a></li><li class="breadcrumb-item active"><%= plan.title %></li></ol></nav>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4"><div><span class="badge badge-soft mb-2">Treatment Plan</span><h1 class="fw-bold mb-1"><%= plan.title %></h1><p class="text-secondary mb-0">خطة المريض <%= plan.patient_name %> • P-<%= plan.patient_id %></p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-primary" href="patient-details?id=<%= plan.patient_id %>"><i class="bi bi-person ms-1"></i>ملف المريض</a></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="soft-card p-3 h-100"><small class="text-secondary">الحالة</small><div class="mt-2"><span class="badge text-bg-primary fs-6"><%= plan.status %></span></div></div></div><div class="col-6 col-lg-3"><div class="soft-card p-3 h-100"><small class="text-secondary">التقدم</small><div class="fs-3 fw-bold"><%= plan.progress %>%</div></div></div><div class="col-6 col-lg-3"><div class="soft-card p-3 h-100"><small class="text-secondary">بدأت</small><div class="fw-bold mt-2"><%= plan.start_date %></div></div></div><div class="col-6 col-lg-3"><div class="soft-card p-3 h-100"><small class="text-secondary">التكلفة التقديرية</small><div class="fs-4 fw-bold mt-1"><%= plan.cost||'—' %> ₪</div></div></div></div>
<div class="soft-card p-4 mb-4"><div class="d-flex justify-content-between gap-3 flex-wrap mb-2"><div><h4 class="fw-bold mb-1">تقدم الخطة</h4><div class="small text-secondary">التقدم محسوب من حالة مراحل العلاج المسجلة.</div></div><strong class="text-primary"><%= plan.progress %>%</strong></div><div class="progress plan-progress" style="height:10px"><div class="progress-bar" style="width:<%= plan.progress %>%"></div></div></div>
<% if(typeof csrfToken!=="undefined"&&typeof plan!=="undefined"){ %><div class="alert alert-light border small">التغييرات السريرية محفوظة في PostgreSQL وتُسجّل في سجل التدقيق. الحذف ممنوع إذا كانت المرحلة مرتبطة بإجراء منفذ.</div><% } %><div class="soft-card p-4 mb-4"><h4 class="fw-bold mb-3">مراحل العلاج</h4><div class="d-grid gap-2" id="planSteps"><% if(!plan.stages.length){ %><p class="text-secondary">لا توجد مراحل بعد.</p><% } %><% for(const s of plan.stages){ %><div class="dynamic-list-item plan-step-item border rounded-3 p-3"><div class="row g-2 align-items-center"><div class="col-md-2"><small class="text-secondary">السن</small><div><%= s.tooth||'—' %></div></div><div class="col-md-6"><small class="text-secondary">المرحلة</small><div class="fw-bold"><%= s.ordering %>. <%= s.description %></div></div><div class="col-md-4"><span class="badge <%= ['done','completed'].includes(s.status)?'text-bg-success':'text-bg-primary' %>"><%= s.status %></span></div></div></div><% } %></div></div>
<div class="soft-card p-4"><h5 class="fw-bold">ملاحظات الخطة</h5><div class="readonly-note mt-3"><%= plan.notes||'لا توجد ملاحظات مسجلة.' %></div>
<% if(plan.status==='active'){ %>
<div class="mt-4 border-top pt-3"><h6 class="fw-bold">إضافة مرحلة</h6>
<form action="/doctor/treatment-plan-details/action" method="post" class="row g-2 align-items-end">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="plan_id" value="<%= plan.id %>"><input type="hidden" name="action" value="add_stage">
<div class="col-md-3"><label class="form-label">السن (اختياري)</label><input class="form-control" name="tooth_number" placeholder="46" maxlength="2"></div>
<div class="col-md-7"><label class="form-label">وصف المرحلة</label><input class="form-control" name="description" maxlength="1000" required></div>
<div class="col-md-2"><button type="submit" class="btn btn-primary w-100">إضافة</button></div>
</form></div>
<% } %>
<div class="mt-4 border-top pt-3"><h6 class="fw-bold">تعديل الخطة</h6>
<form action="/doctor/treatment-plan-details/action" method="post" class="row g-2">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="plan_id" value="<%= plan.id %>"><input type="hidden" name="action" value="update_plan">
<div class="col-md-6"><label class="form-label">اسم الخطة</label><input class="form-control" name="plan_name" maxlength="150" value="<%= plan.title %>" required></div>
<div class="col-md-3"><label class="form-label">التكلفة التقديرية</label><input class="form-control" type="number" step="0.01" min="0" name="plan_cost" value="<%= plan.cost||'' %>"></div>
<div class="col-md-3"><label class="form-label">الحالة</label><select class="form-select" name="plan_status"><% for(const x of ['active','completed','cancelled']){ %><option value="<%= x %>" <%= plan.status===x?'selected':'' %>><%= {active:'نشطة',completed:'مكتملة',cancelled:'ملغاة'}[x] %></option><% } %></select></div>
<div class="col-12"><label class="form-label">ملاحظات الخطة</label><textarea class="form-control" name="plan_notes" rows="2"><%= plan.notes||'' %></textarea></div>
<div class="col-12"><button class="btn btn-outline-primary" type="submit">حفظ التعديل</button></div>
</form></div>
<% if(plan.status==='active'&&plan.stages.length){ %><div class="mt-4 border-top pt-3"><h6 class="fw-bold">تعديل المراحل المسجلة</h6>
<% for(const stage of plan.stages){ %><form class="row g-2 align-items-end border rounded-3 p-2 mb-2" action="/doctor/treatment-plan-details/action" method="post">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="plan_id" value="<%= plan.id %>"><input type="hidden" name="stage_id" value="<%= stage.id %>">
<div class="col-md-2"><label class="form-label">السن</label><input class="form-control" name="tooth_number" maxlength="2" value="<%= stage.tooth||'' %>"></div>
<div class="col-md-5"><label class="form-label">مرحلة <%= stage.ordering %></label><input class="form-control" name="description" maxlength="1000" value="<%= stage.description %>" required></div>
<div class="col-md-3"><label class="form-label">الحالة</label><select class="form-select" name="stage_status"><% for(const x of ['planned','in_progress','completed','cancelled']){ %><option value="<%= x %>" <%= stage.status===x?'selected':'' %>><%= {planned:'مخططة',in_progress:'قيد التنفيذ',completed:'مكتملة',cancelled:'ملغاة'}[x] %></option><% } %></select></div>
<div class="col-md-2 d-flex flex-wrap gap-1"><button class="btn btn-outline-primary btn-sm" name="action" value="update_stage" type="submit">حفظ</button><button class="btn btn-outline-danger btn-sm" name="action" value="delete_stage" type="submit" formnovalidate onclick="return confirm('حذف المرحلة التي لا ترتبط بإجراءات؟')">حذف</button></div>
</form><% } %></div><% } %>
</div>
</section></main>
    <%- include('../partials/doctor/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>




<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="clean-dropdown notification-menu doctor-popover doctor-notification-popover" id="doctorNotifications">
              <div class="px-3 py-2 fw-bold">الإشعارات</div>
              <div class="dropdown-divider"></div>
              <a class="notification-entry" href="appointments"><strong>المريض أحمد وصل</strong>
                <div class="small text-secondary">
                  موعد 11:30 جاهز لبدء الزيارة.
                </div></a>
              
              
            </div><div class="clean-dropdown profile-menu doctor-popover doctor-profile-popover" id="doctorProfile">
              <a class="dropdown-item" href="profile"><i class="bi bi-person ms-2"></i>ملفي الشخصي</a>
              <a class="dropdown-item" href="settings"><i class="bi bi-gear ms-2"></i>الإعدادات</a>
              <div class="dropdown-divider"></div>
              <a class="dropdown-item text-primary fw-bold" href="../clinic/index"><i class="bi bi-arrow-left-right ms-2"></i>تبديل لإدارة
                العيادة</a>
              <div class="px-3 py-2 bg-light rounded-3 mx-2 mb-2">
                <small class="text-secondary d-block">الحساب الحالي</small>
                <strong class="small">د. عمر ناصر • مالك ومدير العيادة</strong>
              </div>
              <button class="dropdown-item text-danger" data-logout="" data-ui-pending="">
                <i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج
              </button>
            </div><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div></body></html>