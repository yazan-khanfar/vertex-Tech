<% if(clinical.status==='in_progress' && !clinical.approved){ %><form method="post" action="/doctor/visit/clinical/action" class="d-flex flex-wrap gap-2 align-items-center mt-2">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="booking_id" value="<%= liveVisit.id %>"><input type="hidden" name="action" value="update_procedure_status"><input type="hidden" name="procedure_id" value="<%= pr.id %>">
