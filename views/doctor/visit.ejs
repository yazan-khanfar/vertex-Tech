<button type="submit" class="btn btn-outline-primary btn-sm">حفظ الحالة</button></form><% } %>
</div><% }} %><div class="sdc-item"><div class="sdc-item-caption"><span class="sdc-item-number">إجراء 1</span><span class="sdc-item-count">عنصر واحد</span><button aria-label="إزالة إجراء 1" class="btn btn-link text-danger btn-sm" data-remove="" data-ui-pending="" hidden="hidden" type="button"><i aria-hidden="true" class="bi bi-trash3"></i> <span>إزالة</span></button></div><div class="sdc-grid four"><label class="sdc-field" for="field-14"><span>الخدمة</span><select class="form-select" data-field="work" data-record-select="service" id="field-14" name="work"><% if(clinical){for(const svc of clinical.services){ %><option value="<%= svc.id %>" data-price="<%= svc.price %>"><%= svc.name %> — <%= svc.price %> ₪</option><% }} %></select></label><label class="sdc-field" for="field-15"><span>السن</span><input class="form-control" data-field="tooth" id="field-15" name="tooth" type="text" value=""/></label><label class="sdc-field" for="field-16"><span>الكمية</span><input class="form-control" data-field="quantity" data-procedure-quantity="" id="field-16" min="1" name="quantity" step="1" type="number" value="1"/></label><label class="sdc-field" for="field-17"><span>سعر الوحدة ₪</span><input class="form-control" data-field="price" data-procedure-price="" id="field-17" min="0" name="price" placeholder="من سعر الخدمة" readonly="readonly" step="0.01" type="number" value=""/></label></div><div class="sdc-grid three mt-2"><label class="sdc-field" for="field-18"><span>حالة الإجراء</span><select class="form-select" data-field="status" id="field-18" name="status"><option selected="selected" value="completed">منفذ</option><option value="planned">مخطط</option><option value="cancelled">ملغى</option></select></label><label class="sdc-field" for="field-19"><span>بند خطة العلاج</span><select class="form-select" data-field="planItem" id="field-19" name="treatment_stage_id"><option value="">غير مرتبط</option><% if(clinical){for(const st of clinical.stages){ %><option value="<%= st.id %>"><%= st.plan %> — <%= st.description %></option><% }} %></select></label><label class="sdc-field" for="field-20"><span>تفاصيل / ملاحظات</span><input class="form-control" data-field="notes" id="field-20" name="notes" type="text" value=""/></label></div></div></div></div><button class="btn btn-outline-primary btn-sm mt-2" data-visit-save="procedure" id="sdcAddProcedure" type="button"><i class="bi bi-plus-lg"></i> حفظ الإجراء وإضافة آخر</button><div class="small mt-2 fw-bold" id="sdcProcedureTotal">مجموع الإجراءات المنفذة: <%= ((clinical && clinical.procedures) || []).filter(p=>p.status==="completed").reduce((n,p)=>n+Number(p.price||0)*Number(p.quantity||0),0).toFixed(2) %> ₪</div></div></section></div>
