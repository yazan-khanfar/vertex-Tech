<!DOCTYPE html>
<html data-style-sections="section-5" dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>بدء الزيارة | Smart Dental Doctor</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/doctor/header') %>
    
    <% if(typeof liveVisit!=="undefined" && liveVisit){ %>
    <% if(visitMessage){ %><div class="container mt-3"><div class="alert alert-success" role="status"><%= visitMessage %></div></div><% } %>
<main class="page-shell" data-clinical-enabled="<%= clinical && !clinical.approved ? "yes" : "no" %>" data-report-approved="<%= clinical && clinical.approved ? "yes" : "no" %>" data-patient-arrived="<%= liveVisit.arrived ? "yes" : "no" %>" data-booking-id="<%= liveVisit.id %>" data-visit-id="<%= liveVisit.visit_id || "" %>" data-visit-status="<%= liveVisit.visit_status || "not_started" %>" id="main-content">
<section class="container py-4 py-lg-5">
<div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end mb-4">
<div>
<span class="badge badge-soft mb-2">ملف الزيارة الطبية</span>
<h1 class="fw-bold">زيارة <%= liveVisit.patient_name %> — <%= liveVisit.service_name %></h1>
<p class="text-secondary mb-0">موعد <%= liveVisit.date %> • <%= liveVisit.time %> • رقم الحجز <%= liveVisit.id %></p>
</div>
<div>
<a class="btn btn-outline-primary" href="/doctor/patient-details?id=<%= liveVisit.patient_id %>">فتح ملف المريض</a>
</div>
</div>
<div class="visit-layout">
<div>
<div class="clinical-card clinical-section mb-4" id="patient-info">
<div class="clinical-head">
<span class="clinical-number" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
<div>
<h4 class="fw-bold mb-1">معلومات المريض</h4>
<div class="text-secondary small">
                    المعلومات الأساسية والتنبيهات المهمة قبل العلاج.
                  </div>
</div>
</div>
<div class="row g-3">
<div class="col-md-4">
<small class="text-secondary">الاسم</small>
<div class="fw-bold"><%= liveVisit.patient_name %></div>
</div>
<div class="col-md-4">
<small class="text-secondary">رقم الملف</small>
<div class="fw-bold"><%= liveVisit.patient_id %></div>
</div>
<div class="col-md-4">
<small class="text-secondary">الهاتف</small>
<div class="fw-bold"><%= liveVisit.phone || "—" %></div>
</div>
</div>
<div class="patient-alert <%= liveVisit.health_notes ? "danger" : "" %> mt-3"><span class="text-secondary">ملاحظات صحية</span>: <%= liveVisit.health_notes || "لا توجد ملاحظات صحية مسجلة." %></div>

</div>
<!-- Visit workflow: five panels, one server-rendered visit and original clinical forms. -->
<div class="visit-workflow" id="visit-workflow">
 <div class="visit-workflow-title d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div><strong>سير العمل الطبي</strong><p class="text-secondary small mb-0">اختر القسم المطلوب؛ بيانات الزيارة تبقى محفوظة في نفس السجل.</p></div>
  <span class="visit-workflow-state" aria-live="polite"><%= clinical && clinical.approved ? 'التقرير معتمد • للقراءة فقط' : liveVisit.visit_status === 'completed' ? 'زيارة مكتملة • التقرير بانتظار الاعتماد' : liveVisit.visit_id ? 'الزيارة قيد العلاج' : 'لم تبدأ الزيارة بعد' %></span>
 </div>
 <nav class="visit-tabs" role="tablist" aria-label="أقسام الزيارة" id="visit-tab-list">
  <button type="button" role="tab" id="visit-tab-start" data-visit-tab-target="start" aria-selected="true" aria-controls="complaint exam"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span>بداية الزيارة</span></button>
  <button type="button" role="tab" id="visit-tab-diagnosis" data-visit-tab-target="diagnosis" aria-selected="false" aria-controls="odontogram diagnosis attachments"><i class="bi bi-grid" aria-hidden="true"></i><span>الأسنان والتشخيص</span></button>
  <button type="button" role="tab" id="visit-tab-treatment" data-visit-tab-target="treatment" aria-selected="false" aria-controls="procedure plan"><i class="bi bi-heart-pulse" aria-hidden="true"></i><span>العلاج</span></button>
  <button type="button" role="tab" id="visit-tab-orders" data-visit-tab-target="orders" aria-selected="false" aria-controls="prescription lab followup"><i class="bi bi-prescription2" aria-hidden="true"></i><span>الوصفات والطلبات</span></button>
  <button type="button" role="tab" id="visit-tab-finish" data-visit-tab-target="finish" aria-selected="false" aria-controls="report doctorInvoiceCard"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><span>التقرير والإنهاء</span></button>
 </nav>
 <div class="visit-tab-heading" aria-live="polite"><strong id="visit-tab-heading-text">بداية الزيارة</strong><span id="visit-tab-help">سجّل الشكوى والفحص الأولي، ثم انتقل إلى بقية الأقسام حسب الحاجة.</span></div>
 <p class="visit-unsaved-note" id="visit-unsaved-note" role="status" hidden><i class="bi bi-exclamation-circle" aria-hidden="true"></i> توجد مدخلات لم تُحفظ بعد. يمكنك التنقل بين التبويبات دون فقدانها؛ احفظ القسم قبل مغادرة الصفحة.</p>
</div>
<div class="clinical-card clinical-section mb-4" id="complaint" data-visit-tab="start">
<div class="clinical-head">
<span class="clinical-number" aria-hidden="true">١</span>
<div>
<h4 class="fw-bold mb-1">سبب الزيارة / Chief Complaint</h4>
<div class="text-secondary small">
                    سجل شكوى المريض بكلماته قبل التشخيص.
                  </div>
</div>
</div>
<textarea class="form-control" id="chiefComplaint" maxlength="150" name="chief_complaint" rows="3"><%= liveVisit.chief_complaint || "" %></textarea>
</div>
<div class="clinical-card clinical-section mb-4" id="exam" data-visit-tab="start">
<div class="clinical-head">
<span class="clinical-number" aria-hidden="true">٢</span>
<div>
<h4 class="fw-bold mb-1">الفحص السريري</h4>
<div class="text-secondary small">نتائج الفحص داخل الفم.</div>
</div>
</div>
<div class="exam-grid mb-3">
<label class="exam-check" for="field-2"><input class="form-check-input ms-2" id="field-2" name="finding" value="وجود تسوس" type="checkbox" <%= clinical && clinical.findings && clinical.findings.some(f => f.finding === "وجود تسوس") ? "checked" : "" %>/>
                  وجود تسوس</label><label class="exam-check"><input class="form-check-input ms-2" id="field-3" name="finding" value="ألم عند الضغط" type="checkbox" <%= clinical && clinical.findings && clinical.findings.some(f => f.finding === "ألم عند الضغط") ? "checked" : "" %>/>
                  ألم عند الضغط</label><label class="exam-check"><input class="form-check-input ms-2" id="field-4" name="finding" value="تورم" type="checkbox" <%= clinical && clinical.findings && clinical.findings.some(f => f.finding === "تورم") ? "checked" : "" %>/>
                  تورم</label><label class="exam-check"><input class="form-check-input ms-2" id="field-5" name="finding" value="حركة في السن" type="checkbox" <%= clinical && clinical.findings && clinical.findings.some(f => f.finding === "حركة في السن") ? "checked" : "" %>/> حركة
                  في السن</label><label class="exam-check"><input class="form-check-input ms-2" id="field-6" name="finding" value="نزف لثوي" type="checkbox" <%= clinical && clinical.findings && clinical.findings.some(f => f.finding === "نزف لثوي") ? "checked" : "" %>/> نزف
                  لثوي</label><label class="exam-check"><input class="form-check-input ms-2" id="field-7" name="finding" value="حساسية حرارية" type="checkbox" <%= clinical && clinical.findings && clinical.findings.some(f => f.finding === "حساسية حرارية") ? "checked" : "" %>/>
                  حساسية حرارية</label>
</div>
<button class="btn btn-outline-primary btn-sm mb-3" data-visit-save="findings" type="button">حفظ نتائج الفحص</button>
<label class="form-label">ملاحظات الفحص</label><textarea class="form-control" id="examinationNotes" maxlength="6000" name="examination_notes" rows="3"><%= liveVisit.examination_notes || "" %></textarea>
</div>
