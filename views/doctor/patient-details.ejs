<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
<meta charset="utf-8">
<meta content="width=device-width,initial-scale=1" name="viewport">
<title>ملف المريض | Smart Dental Doctor</title>
<link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
<link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
<!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
<link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
<body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
<%- include('../partials/doctor/header') %>


<main class="page-shell" data-doctor-patient-details id="main-content"><section class="container py-4 py-lg-5">
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="patients">مرضاي</a></li><li class="breadcrumb-item active"><%= patient.name %></li></ol></nav>
<div class="soft-card p-4 mb-4"><div class="row g-4 align-items-center"><div class="col-lg-8"><div class="d-flex gap-3 align-items-center"><div class="patient-avatar" style="width:64px;height:64px"><%= patient.name.split(/\s+/).slice(0,2).map(v=>v[0]).join('') %></div><div><h2 class="fw-bold mb-1"><%= patient.name %></h2><div class="text-secondary">P-<%= patient.id %> • <%= patient.phone %></div></div></div></div><div class="col-lg-4 d-flex gap-2 flex-wrap justify-content-lg-end"><% for(const a of patient.allergies){ %><span class="alert-chip"><i class="bi bi-exclamation-triangle"></i><%= a %></span><% } %></div></div></div>
<div class="soft-card p-4 mb-4"><h5 class="fw-bold">الملخص الطبي</h5><div class="medical-summary mt-3">
<div class="summary-row"><span>فصيلة الدم</span><strong><%= patient.blood||'غير محددة' %></strong></div><div class="summary-row"><span>الحساسية</span><strong class="text-danger"><%= patient.allergies.join('، ')||'لا توجد حساسية مسجلة' %></strong></div><div class="summary-row"><span>أمراض مزمنة</span><strong><%= patient.chronic.join('، ')||'لا توجد أمراض مسجلة' %></strong></div><div class="summary-row"><span>أدوية حالية</span><strong><%= patient.meds.join('، ')||'لا توجد أدوية مسجلة' %></strong></div><div class="summary-row"><span>ملاحظات صحية</span><strong><%= patient.notes||'لا توجد ملاحظات' %></strong></div></div></div>
<div class="soft-card p-4 mb-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="fw-bold mb-1">مواعيدك وزياراتك مع المريض</h4><div class="small text-secondary">تظهر فقط الحالات المرتبطة بك في العيادة المختارة.</div></div><a class="btn btn-primary btn-sm" href="appointments">المواعيد</a></div><div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 responsive-stack-table system-data-table"><thead class="table-light"><tr><th>التاريخ</th><th>الخدمة</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>
<% if(!patient.visits.length){ %><tr><td colspan="4" class="text-secondary">لا توجد مواعيد مسجلة مع هذا الطبيب.</td></tr><% } %>
<% for(const v of patient.visits){ %><tr><td data-label="التاريخ"><%= v.date %></td><td data-label="الخدمة"><%= v.service %></td><td data-label="الحالة"><%= v.status %></td><td data-label="الإجراء"><% if(['confirmed','in_progress','completed'].includes(v.status)){ %><a class="btn btn-sm btn-primary" href="visit?booking_id=<%= v.booking_id %>">فتح الزيارة</a><% }else{ %>—<% } %></td></tr><% } %></tbody></table></div></div>
<div class="soft-card p-4" id="treatment-plan-summary"><h4 class="fw-bold mb-3">خطط العلاج لدى هذا الطبيب</h4><% if(!patient.plans.length){ %><p class="text-secondary mb-0">لا توجد خطط علاج مسجلة لهذا المريض عند هذا الطبيب.</p><% } %>
<div class="d-grid gap-2"><% for(const plan of patient.plans){ %><div class="border rounded-3 p-3 d-flex justify-content-between gap-3 align-items-center flex-wrap"><div><strong><%= plan.title %></strong><div class="small text-secondary"><%= plan.start_date %> • <%= plan.status %> • <%= plan.done %> / <%= plan.total %> مراحل</div></div><a href="treatment-plan-details?id=<%= plan.id %>" class="btn btn-outline-primary btn-sm">عرض الخطة</a></div><% } %></div></div>
</section></main>
<%- include('../partials/doctor/footer') %>
<div class="toast-container position-fixed bottom-0 start-0 p-3">
<div class="toast align-items-center text-bg-primary border-0" id="appToast">
<div class="d-flex">
<div class="toast-body">تمت العملية</div>
<button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
</div>
</div>
</div>
<script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>

<!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="clean-dropdown notification-menu doctor-popover doctor-notification-popover" id="doctorNotifications">
<div class="px-3 py-2 fw-bold">الإشعارات</div>
<div class="dropdown-divider"></div>
<a class="notification-entry" href="appointments"><strong>المريض أحمد وصل</strong>
<div class="small text-secondary">
                  موعد 11:30 جاهز لبدء الزيارة.
                </div></a>


</div><div class="clean-dropdown profile-menu doctor-popover doctor-profile-popover" id="doctorProfile">
<a class="dropdown-item" href="profile"><i class="bi bi-person ms-2"></i>ملفي الشخصي</a>
<a class="dropdown-item" href="settings"><i class="bi bi-gear ms-2"></i>الإعدادات</a>
<div class="dropdown-divider"></div>
<a class="dropdown-item text-primary fw-bold" href="../clinic/index"><i class="bi bi-arrow-left-right ms-2"></i>تبديل لإدارة
                العيادة</a>
<div class="px-3 py-2 bg-light rounded-3 mx-2 mb-2">
<small class="text-secondary d-block">الحساب الحالي</small>
<strong class="small">د. عمر ناصر • مالك ومدير العيادة</strong>
</div>
<button class="dropdown-item text-danger" data-logout="" data-ui-pending="">
<i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج
              </button>
</div><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div></body></html>