<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>جدولي وغيابي | Smart Dental Doctor</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/doctor/header') %>
    
    <main class="page-shell" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
          <div>
            <span class="badge badge-soft mb-2">Availability</span>
            <h1 class="fw-bold fs-2 mb-2">جدول دوامي والغيابات</h1>
            <p class="text-secondary mb-0">
              هذا القسم للعرض فقط. جدول الدوام والغيابات تُدار من إدارة العيادة
              وتنعكس هنا على الفترات المتاحة للحجز.
            </p>
          </div>
        </div>
        <div class="alert alert-primary rounded-4 border-0">
          <i class="bi bi-info-circle ms-2"></i>هذه نسخة للقراءة فقط. أي تعديل
          يتم من إدارة العيادة ويُستخدم في حساب المواعيد المتاحة للمريض.
        </div>
        <div class="row g-4">
          <div class="col-xl-8 col-xxl-9">
            <div class="soft-card p-4">
              <div class="d-flex justify-content-between align-items-start gap-3 mb-2 schedule-card-head">
                <div>
                  <h4 class="fw-bold mb-1">الجدول الأسبوعي</h4>
                  <small class="text-secondary">تعرض الفترات المعتمدة من إدارة العيادة؛ لا يمكن للطبيب
                    تعديلها من هذه الصفحة.</small>
                </div>
                <span class="badge text-bg-success">مفعّل</span>
              </div>
              <div class="schedule-version-note alert alert-light border rounded-3 small mb-3 mt-2" >
                <i class="bi bi-clock-history ms-1"></i>آخر تحديث:
                <strong>وفق البيانات الحالية</strong> بواسطة إدارة العيادة.
              </div>
              <div class="table-responsive mobile-stack-wrapper table-ui-shell">
                <table class="table align-middle mb-0 doctor-weekly-schedule-table responsive-stack-table system-data-table">
                  <thead>
                    <tr>
                      <th>اليوم</th>
                      <th>من</th>
                      <th>إلى</th>
                      <th>الاستراحة</th>
                      <th>الحالة</th>
                    </tr>
                  </thead>
                  <tbody id="doctorScheduleBody"><% const daynames=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت']; %><% for(let d=0;d<7;d++){let periods=profile.periods.filter(p=>Number(p.day)===d);if(!periods.length){ %><tr><td data-label="اليوم"><%= daynames[d] %></td><td>—</td><td>—</td><td>—</td><td><span class="badge text-bg-secondary">غير متاح</span></td></tr><% }for(const p of periods){ %><tr><td data-label="اليوم"><%= daynames[d] %></td><td data-label="من"><%= p.start %></td><td data-label="إلى"><%= p.end %></td><td data-label="الاستراحة">—</td><td data-label="الحالة"><span class="badge <%= p.active?'text-bg-success':'text-bg-secondary' %>"><%= p.active?'نشط':'غير نشط' %></span></td></tr><% } } %></tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="col-xl-4 col-xxl-3 doctor-availability-side">
            <div class="soft-card p-4 doctor-absence-card">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                  <h4 class="fw-bold mb-1">الغيابات والإجازات المسجلة</h4>
                  <small class="text-secondary">الغيابات والإجازات المسجلة من إدارة العيادة — عرض
                    فقط.</small>
                </div>
                <span class="badge text-bg-warning"><%= profile.absences.length %> غياب</span>
              </div>
              <% if(!profile.absences.length){ %><div class="small text-secondary">لا توجد غيابات مسجلة.</div><% } %>
              <% for(const a of profile.absences){ %><div class="doctor-absence-item"><span class="icon-box"><i class="bi bi-calendar-x"></i></span><div class="flex-grow-1"><strong><%= a.start %> — <%= a.end %></strong><div class="small text-secondary"><%= a.reason %></div><div class="small text-danger">غير متاح للحجز</div></div></div><% } %>
            </div>
            <div class="soft-card p-4 doctor-availability-summary">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                  <h5 class="fw-bold mb-1">ملخص التوفر</h5>
                  <small class="text-secondary">نظرة سريعة على جدولك الحالي.</small>
                </div>
                <span class="icon-box"><i class="bi bi-calendar2-week"></i></span>
              </div>
              <div class="summary-row">
                <span>أيام الدوام</span><strong><%= new Set(profile.periods.filter(x=>x.active).map(x=>x.day)).size %> أيام</strong>
              </div>
              <div class="summary-row">
                <span>إجمالي الساعات</span><strong><%= profile.periods.filter(x=>x.active).reduce((sum,p)=>{const mins=t=>{const [h,m]=String(t).split(':').map(Number);return h*60+m;};return sum+Math.max(0,mins(p.end)-mins(p.start));},0)/60 %> ساعة / أسبوع</strong>
              </div>
              <div class="summary-row">
                <span>مدة الموعد الافتراضية</span><strong><%= profile.services.length?profile.services[0].duration+' دقيقة':'حسب الخدمة' %></strong>
              </div>
              <div class="summary-row">
                <span>غيابات قادمة</span><strong class="text-warning"><%= profile.absences.filter(a=>a.end>=now.date).length %></strong>
              </div>
            </div>
          </div>
        </div>
</section>
    </main>
    <%- include('../partials/doctor/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="clean-dropdown notification-menu doctor-popover doctor-notification-popover" id="doctorNotifications">
              <div class="px-3 py-2 fw-bold">الإشعارات</div>
              <div class="dropdown-divider"></div>
              <a class="notification-entry" href="appointments"><strong>المريض أحمد وصل</strong>
                <div class="small text-secondary">
                  موعد 11:30 جاهز لبدء الزيارة.
                </div></a>
              
              
            </div><div class="clean-dropdown profile-menu doctor-popover doctor-profile-popover" id="doctorProfile">
              <a class="dropdown-item" href="profile"><i class="bi bi-person ms-2"></i>ملفي الشخصي</a>
              <a class="dropdown-item" href="settings"><i class="bi bi-gear ms-2"></i>الإعدادات</a>
              <div class="dropdown-divider"></div>
              <a class="dropdown-item text-primary fw-bold" href="../clinic/index"><i class="bi bi-arrow-left-right ms-2"></i>تبديل لإدارة
                العيادة</a>
              <div class="px-3 py-2 bg-light rounded-3 mx-2 mb-2">
                <small class="text-secondary d-block">الحساب الحالي</small>
                <strong class="small">الطبيب الحالي • مالك ومدير العيادة</strong>
              </div>
              <button class="dropdown-item text-danger" data-logout="" data-ui-pending="">
                <i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج
              </button>
            </div><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div></body></html>