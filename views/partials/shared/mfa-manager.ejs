<section id="sdc-mfa" class="soft-card border rounded-4 p-4 mt-4 mb-4" aria-label="التحقق بخطوتين">
<h4 class="fw-bold mb-2"><i class="bi bi-shield-lock ms-2"></i>التحقق بخطوتين — حماية الحساب</h4>
<p class="text-secondary small">إدارة تطبيق المصادقة ورموز الاسترداد من إعدادات الحساب الأصلية، دون الانتقال إلى صفحة أخرى.</p>
<% const {error='',message='',codes=null,enabled=false,secret=null,uri=null,csrfToken=''} = (typeof mfaView!=='undefined'&&mfaView)||{}; %>
<% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<% if(message){ %><div class="alert alert-success" role="status"><%= message %></div><% } %>
<% if(codes){ %><div class="alert alert-warning"><strong>رموز الاسترداد (تظهر مرة واحدة فقط):</strong><p>احتفظ بها بعيدًا عن هاتفك. كل رمز يُستخدم مرة واحدة. لا تشاركها مع أحد.</p>
<div class="row row-cols-1 row-cols-sm-2 g-2" dir="ltr" style="font-family:monospace"><% for(const code of codes){ %><div class="col"><code><%= code %></code></div><% } %></div></div><% } %>
<% if(enabled){ %>
<div class="alert alert-success"><i class="bi bi-check-circle ms-1"></i>التحقق بخطوتين مفعّل لهذا الحساب.</div>
<h2 class="h5 mt-4">تعطيل التحقق بخطوتين</h2>
<p class="text-secondary small">للتعطيل أدخل كلمة المرور ورمزًا من التطبيق أو رمز استرداد لم يُستخدم بعد.</p>
<form method="post" action="/auth/security/disable" autocomplete="off">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="profile_scope" value="<%= mfaScope %>">
<label for="disable-pass" class="form-label">كلمة المرور الحالية</label><input id="disable-pass" name="password" class="form-control mb-3" type="password" required autocomplete="current-password">
<label for="disable-code" class="form-label">رمز التطبيق أو الاسترداد</label><input id="disable-code" name="code" class="form-control mb-3" type="text" required maxlength="50" autocomplete="one-time-code">
<button class="btn btn-outline-danger" type="submit">تعطيل التحقق الثنائي</button></form>
<% } else if(secret){ %>
<div class="alert alert-info">افتح تطبيق مصادقة مثل Google Authenticator أو Microsoft Authenticator، وأضف حسابًا باستخدام المفتاح أدناه. لا تشارك المفتاح.</div>
<label class="form-label" for="secret">مفتاح الإعداد (Base32)</label>
<input dir="ltr" class="form-control mb-2" id="secret" value="<%= secret %>" readonly onclick="this.select()">
<details class="mb-3"><summary>رابط إعداد تطبيق المصادقة</summary><code class="d-block text-break mt-2" dir="ltr"><%= uri %></code><small>يمكن إضافته يدويًا إن كان التطبيق يدعم الرابط. لا تشاركه.</small></details>
<form method="post" action="/auth/security/confirm">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="profile_scope" value="<%= mfaScope %>">
<label for="setup-code" class="form-label">الرمز المكون من 6 أرقام</label><input id="setup-code" name="code" class="form-control mb-3" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
<button class="btn btn-primary" type="submit">تأكيد التفعيل</button></form>
<form class="mt-3" method="post" action="/auth/security/cancel"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="profile_scope" value="<%= mfaScope %>"><button class="btn btn-outline-secondary" type="submit">إلغاء الإعداد</button></form>
<% } else { %>
<div class="alert alert-secondary">التحقق بخطوتين غير مفعّل حاليًا.</div>
<form method="post" action="/auth/security/start">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="profile_scope" value="<%= mfaScope %>">
<label for="current-password" class="form-label">أدخل كلمة مرورك الحالية لبدء الإعداد</label>
<input id="current-password" type="password" name="password" class="form-control mb-3" autocomplete="current-password" required>
<button class="btn btn-primary" type="submit">إعداد تطبيق المصادقة</button></form>
<% } %>
</section><script>
/* UI-only: open the original security tab if MFA redirects to an anchor there. */
(function () {
  function revealMfa(){
    if (window.location.hash !== '#sdc-mfa') return;
    var section = document.getElementById('sdc-mfa');
    if (!section) return;
    var pane = section.closest('.tab-pane');
    if (pane && window.bootstrap && window.bootstrap.Tab) {
      var trigger = document.querySelector('[data-bs-toggle="tab"][data-bs-target="#' + pane.id + '"], [data-bs-toggle="pill"][data-bs-target="#' + pane.id + '"]');
      if (trigger) window.bootstrap.Tab.getOrCreateInstance(trigger).show();
    }
    window.requestAnimationFrame(function(){section.scrollIntoView({block:'start'});});
  }
  window.addEventListener('load',revealMfa);
  window.addEventListener('hashchange',revealMfa);
})();
</script>
