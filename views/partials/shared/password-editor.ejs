<section class="soft-card border rounded-4 p-4 mt-4 mb-4" id="sdc-password" aria-label="تغيير كلمة المرور">
  <h4 class="fw-bold mb-2"><i class="bi bi-key ms-2"></i>تغيير كلمة المرور</h4>
  <p class="text-secondary small">أدخل كلمة المرور الحالية والجديدة. سيتم إنهاء جميع الجلسات بعد النجاح، مع الحفاظ على التحقق الثنائي MFA.</p>
  <% if (typeof passwordChangeError !== 'undefined' && passwordChangeError) { %>
    <div class="alert alert-danger" role="alert"><%= passwordChangeError %><% if (typeof passwordChangeReference !== "undefined" && passwordChangeReference) { %> <small>(رمز التشخيص: <%= passwordChangeReference %>)</small><% } %></div>
  <% } %>
  <form action="/auth/change-password" method="post" autocomplete="off">
    <input type="hidden" name="csrf_token" value="<%= passwordChangeCsrf %>">
    <input type="hidden" name="profile_scope" value="<%= passwordScope %>">
    <div class="row g-3">
      <div class="col-12"><label for="password-old-<%= passwordScope %>" class="form-label">كلمة المرور الحالية</label>
        <input class="form-control" id="password-old-<%= passwordScope %>" name="current_password" type="password" autocomplete="current-password" required></div>
      <div class="col-md-6"><label for="password-new-<%= passwordScope %>" class="form-label">كلمة المرور الجديدة</label>
        <input class="form-control" id="password-new-<%= passwordScope %>" name="new_password" type="password" autocomplete="new-password" minlength="14" maxlength="128" required></div>
      <div class="col-md-6"><label for="password-confirm-<%= passwordScope %>" class="form-label">تأكيد كلمة المرور</label>
        <input class="form-control" id="password-confirm-<%= passwordScope %>" name="confirm_password" type="password" autocomplete="new-password" minlength="14" maxlength="128" required></div>
      <div class="col-12"><button class="btn btn-primary" type="submit">حفظ كلمة المرور الجديدة</button></div>
    </div>
  </form>
</section>
