<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>تفاصيل المختبر | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/clinic/header') %>
    

    
    <% if(feedback){ %><div class="alert alert-success container mt-3"><%= feedback %></div><% } %><main class="page-shell" data-lab-details-page="" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
          <div>
            <a class="small text-decoration-none" href="lab-cases"><i class="bi bi-arrow-right ms-1"></i>العودة للمختبرات</a>
            <div class="d-flex align-items-center gap-2 mt-2"><h1 class="fw-bold mb-0" id="labDetailName"><%= lab.Laboratory_Name %></h1><span class="badge text-bg-success" id="labDetailStatus"><%= label(lab.Relationship_Status) %></span></div>
            <div class="text-secondary mt-2"><span id="labDetailAddress"><%= lab.Address %></span> • <span id="labDetailPhone"><%= lab.Phone %></span></div>
          </div>
          <div class="d-flex gap-2 flex-wrap"><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createLabCaseModal" <%= lab.Relationship_Status==='active'?'':'disabled' %>>حالة مخبرية جديدة</button><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editLabModal" type="button">إعدادات التعامل</button><button class="btn btn-outline-secondary" id="archiveCurrentLab" type="submit" form="archiveLabForm">أرشفة تعامل العيادة</button></div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">كل الحالات</small><div class="fs-3 fw-bold" id="labCasesTotal"><%= cases.length %></div></div></div>
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">تم الإرسال</small><div class="fs-3 fw-bold text-info" id="labCasesSent"><%= cases.filter(x=>x.Order_Status==='sent').length %></div></div></div>
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">تم الاستلام</small><div class="fs-3 fw-bold text-success" id="labCasesReceived"><%= cases.filter(x=>x.Order_Status==='received').length %></div></div></div>
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">متأخرة</small><div class="fs-3 fw-bold text-danger" id="labCasesOverdue"><%= cases.filter(x=>['draft','sent'].includes(x.Order_Status)&&x.Expected_Delivery_Date&&new Date(x.Expected_Delivery_Date)<new Date(new Date().toDateString())).length %></div></div></div>
        </div>

        <div class="filter-panel mb-4"><div class="row g-3"><div class="col-lg-5"><input class="form-control" id="labCaseSearch" placeholder="ابحث برقم الحالة أو المريض أو الطبيب أو نوع العمل" value="" name="lab_case_search" form="backend-form-1"></div><div class="col-lg-3"><select class="form-select" id="labCaseStatus" name="lab_case_status" form="backend-form-1"><option value="all" selected>كل الحالات</option><option value="waiting">بانتظار الإرسال</option><option value="sent">تم الإرسال</option><option value="received">تم الاستلام</option><option value="installed">تم التركيب</option></select></div><div class="col-lg-4"><select class="form-select" id="labCaseDoctor" data-record-select="doctor" name="lab_case_doctor" form="backend-form-1"><option value="all" selected>كل الأطباء</option><% for(const d of doctors){ %><option value="<%= d.Doctor_ID %>">د. <%= d.First_Name %> <%= d.Last_Name %></option><% } %></select></div></div></div>

        <div class="soft-card p-3"><div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 wide-data-table responsive-stack-table system-data-table"><thead class="table-light"><tr><th>الرقم</th><th>المريض</th><th>الطبيب</th><th>العمل / السن</th><th>الحالة</th><th>التسليم المتوقع</th><th>الإجراء</th></tr></thead><tbody id="labCasesBody">
          <% for(const c of cases){ %>
          <tr data-lab-case data-status="<%= c.Order_Status %>" data-doctor="<%= c.Doctor_ID %>" data-record-id="<%= c.Lab_Order_ID %>">
            <td data-label="الرقم" class="table-primary-cell"><strong>LC-<%= c.Lab_Order_ID %></strong></td><td data-label="المريض"><%= c.patient_first %> <%= c.patient_last %></td><td data-label="الطبيب">د. <%= c.doctor_first %> <%= c.doctor_last %></td><td data-label="العمل / السن"><%= c.work %></td><td data-label="الحالة" class="table-status-cell"><span class="badge <%= c.Order_Status==='received'?'text-bg-success':c.Order_Status==='sent'?'text-bg-info':'text-bg-secondary' %>" data-case-status-badge><%= label(c.Order_Status) %></span></td><td data-label="التسليم المتوقع"><%= c.Expected_Delivery_Date?new Date(c.Expected_Delivery_Date).toLocaleDateString('ar-PS'):'—' %></td>
            <td data-label="الإجراء" class="table-actions-cell"><div class="d-flex gap-1 flex-wrap table-action-grid">
              <% if(c.Order_Status==='draft'||c.Order_Status==='sent'){ %><form method="post" action="/clinic/lab-details/<%= lab.Laboratory_ID %>/case/<%= c.Lab_Order_ID %>"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= c.Order_Status==='draft'?'send':'receive' %>"><button type="submit" class="btn btn-sm btn-primary"><%= c.Order_Status==='draft'?'تسجيل تم الإرسال':'تسجيل تم الاستلام' %></button></form><% } %>
              <% if(c.Order_Status==='draft'){ %><button class="btn btn-sm btn-light border" data-lab-transfer="<%= c.Lab_Order_ID %>" data-ui-open="#transferLabModal" type="button">نقل لمختبر</button><% } %>
            </div></td>
          </tr>
          <% } %>
        </tbody></table></div><div class="text-center p-4 d-none" id="labCasesEmpty"><span class="text-secondary">لا توجد حالات مطابقة للفلاتر.</span></div></div>

        <div class="alert alert-info border-0 rounded-4 mt-4 mb-0"><strong>الصلاحيات:</strong> العيادة أو الموظف المخول يسجل <b>تم الإرسال</b> و<b>تم الاستلام</b>. الطبيب وحده يسجل <b>تم التركيب للمريض</b>.</div>
      </section>
    </main>
    
    <div class="modal fade" id="createLabCaseModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 rounded-4"><form method="post" action="/clinic/lab-details/<%= lab.Laboratory_ID %>/create"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title fw-bold">حالة مخبرية جديدة</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">الزيارة المرتبطة *</label><select class="form-select" name="visit_id" required><option value="">اختر الزيارة</option><% for(const v of visits){ %><option value="<%= v.Visit_ID %>">V-<%= v.Visit_ID %> • <%= v.First_Name %> <%= v.Last_Name %> • <%= new Date(v.Appointment_Date).toLocaleDateString('ar-PS') %></option><% } %></select></div><div class="col-md-6"><label class="form-label">التسليم المتوقع *</label><input class="form-control" name="delivery_date" type="date" required min="<%= new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Hebron'}).format(new Date()) %>"></div><div class="col-md-6"><label class="form-label">نوع العمل *</label><input class="form-control" name="work_type" maxlength="150" required></div><div class="col-md-3"><label class="form-label">رقم السن</label><input class="form-control" type="number" name="tooth" min="11" max="85"></div><div class="col-md-3"><label class="form-label">الدرجة / اللون</label><input class="form-control" name="shade" maxlength="150"></div><div class="col-12"><label class="form-label">تعليمات وملاحظات</label><textarea class="form-control" name="notes" maxlength="4000" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-primary" type="submit">إنشاء الحالة</button></div></form></div></div></div>
    <div class="modal fade" id="transferLabModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold">نقل الحالة إلى مختبر آخر</h5>
              <small class="text-secondary" id="transferLabCaseLabel">اختر مختبراً نشطاً قبل تسجيل الإرسال.</small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body">
            <label class="form-label">المختبر الجديد</label>
            <select class="form-select" id="transferLabSelect" name="transfer_lab_select" form="backend-form-2"><% for(const l of targetLabs){ %><option value="<%= l.Laboratory_ID %>"><%= l.Laboratory_Name %> — مختبر نشط</option><% } %></select>
            <div class="alert alert-warning border-0 rounded-3 mt-3 mb-0 small">
              يمكن نقل الحالة فقط وهي بحالة <b>بانتظار الإرسال</b>. بعد تسجيل الإرسال لا يمكن نقلها من هذه الشاشة.
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button>
            <button class="btn btn-primary" id="confirmLabTransfer" form="backend-form-2" type="submit">تأكيد النقل</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="editLabModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 rounded-4"><div class="modal-header"><div><h5 class="modal-title fw-bold">إعدادات تعامل العيادة مع المختبر</h5><small class="text-secondary">الملاحظات وحالة التعامل خاصة بهذه العيادة. بيانات المختبر العامة يديرها مدير المنصة.</small></div><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">ملاحظات داخلية</label><textarea class="form-control" id="editLabNotes" rows="3" name="edit_lab_notes" form="backend-form-3"><%= lab.Internal_Notes||'' %></textarea></div></div><label class="form-label mt-3" for="clinicLabRelationshipStatus">حالة التعامل داخل العيادة</label><select class="form-select" id="clinicLabRelationshipStatus" name="relationship_status" form="backend-form-3"><option value="active" <%= lab.Relationship_Status==='active'?'selected':'' %>>نشط</option><option value="archived" <%= lab.Relationship_Status==='archived'?'selected':'' %>>مؤرشف</option></select></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" id="saveClinicLabEdit" form="backend-form-3" type="submit">حفظ التعديل</button></div></div></div></div>
    <%- include('../partials/clinic/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script><script src="/clinic/assets/batch4.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-2" method="post" action="/clinic/lab-details/<%= lab.Laboratory_ID %>/case/0" hidden=""><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="action" value="transfer"></form><form id="backend-form-3" method="post" action="/clinic/lab-details/<%= lab.Laboratory_ID %>/relationship" hidden=""><input type="hidden" name="csrf_token" value="<%= csrfToken %>"></form><form id="archiveLabForm" method="post" action="/clinic/lab-details/<%= lab.Laboratory_ID %>/relationship" hidden=""><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="relationship_status" value="<%= lab.Relationship_Status==='active'?'archived':'active' %>"><input type="hidden" name="edit_lab_notes" value="<%= lab.Internal_Notes||'' %>"></form></body></html>