<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
<meta charset="utf-8">
<meta content="width=device-width,initial-scale=1" name="viewport">
<title>ملف المريض | Smart Dental Clinic</title>
<link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
<link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
<!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
<link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
<body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
<%- include('../partials/clinic/header') %>


<main class="page-shell" data-clinic-patient-details="" id="main-content">
<section class="container py-4 py-lg-5">
<nav aria-label="breadcrumb">
<ol class="breadcrumb">
<li class="breadcrumb-item"><a href="patients">المرضى</a></li>
<li class="breadcrumb-item active" id="clinicPatientBreadcrumb"><%=patient.name%></li>
</ol>
</nav>
<div class="soft-card p-4 mb-4">
<div class="d-flex flex-column flex-md-row gap-4 align-items-md-center">
<div class="patient-avatar-box" id="clinicPatientAvatar" style="width: 80px; height: 80px; font-size: 1.4rem"><%=patient.name.split(/\s+/).slice(0,2).map(x=>x[0]).join('')%></div>
<div class="flex-grow-1">
<h2 class="fw-bold mb-1" id="clinicPatientName"><%=patient.name%></h2>
<div class="text-secondary" id="clinicPatientMeta">P-<%=patient.id%> • <%=patient.phone%> • <%=patient.email||'بدون بريد مسجل'%></div>
</div>
<div class="d-flex gap-2">
<a class="btn btn-primary" href="new-appointment?patient=<%=encodeURIComponent(patient.id)%>" id="clinicPatientNewAppointment">
<i class="bi bi-calendar2-plus ms-1"></i>إضافة موعد
              </a>
<a class="btn btn-outline-primary" href="invoices">قائمة فواتير العيادة</a>
</div>
</div>
</div>
<div class="soft-card p-4 mb-4">
<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
<div>
<h4 class="fw-bold mb-1">المعلومات الصحية الأساسية</h4>
<div class="small text-secondary">
                للقراءة والتنبيه قبل الزيارة. المحتوى السريري للزيارات يبقى من
                صلاحية الطبيب.
              </div>
</div>
<span class="badge text-bg-light border">Patient profile</span>
</div>
<div class="row g-3">
<div class="col-md-4">
<small class="text-secondary">فصيلة الدم</small>
<div class="fw-bold" id="clinicPatientBlood"><%=patient.blood==='unknown'?'غير معروفة':patient.blood%></div>
</div>
<div class="col-md-4">
<small class="text-secondary">الحساسية</small>
<div class="fw-bold text-danger" id="clinicPatientAllergy"><%=patient.allergies.join('، ')||'لم تُسجّل'%></div>
</div>
<div class="col-md-4">
<small class="text-secondary">الأمراض المزمنة</small>
<div class="fw-bold" id="clinicPatientChronic"><%=patient.chronic.join('، ')||'لم تُسجّل'%></div>
</div>
<div class="col-md-6">
<small class="text-secondary">الأدوية الحالية</small>
<div class="fw-bold" id="clinicPatientMeds"><%=patient.medications.join('، ')||'لم تُسجّل'%></div>
</div>
<div class="col-md-6">
<small class="text-secondary">ملاحظات صحية</small>
<div class="fw-bold" id="clinicPatientNotes"><%=patient.notes%></div>
</div>
</div>
</div>
<div class="row g-4">
<div class="col-lg-8">
<div class="soft-card p-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<div>
<h4 class="fw-bold mb-1">الزيارات وتقارير الطبيب</h4>
<p class="text-secondary small mb-0">
                    كل زيارة وتقريرها الطبي في نفس السجل.
                  </p>
</div>
<span class="badge badge-soft">تقارير الطبيب للقراءة فقط</span>
</div>
<div class="table-responsive mobile-stack-wrapper table-ui-shell">
<table class="table align-middle mb-0 medium-data-table responsive-stack-table system-data-table">
<thead class="table-light">
<tr>
<th>التاريخ</th>
<th>الطبيب</th>
<th>الخدمة</th>
<th>حالة الزيارة</th>
<th>التقرير الطبي</th>
<th>الإجراءات</th>
</tr>
</thead>
<tbody id="clinicPatientVisitsBody"><% if(!patient.visits.length){ %>
<tr><td colspan="6" class="text-center text-secondary py-4">لا توجد زيارات مسجلة لهذا المريض في هذه العيادة.</td></tr>
<% } else { for(const v of patient.visits){ %>
<tr><td data-label="التاريخ" class="table-primary-cell"><%=v.date%></td>
<td data-label="الطبيب"><%=v.doctor%></td><td data-label="الخدمة"><%=v.service%></td>
<td data-label="حالة الزيارة"><span class="badge text-bg-light border"><%=v.status%></span></td>
<td data-label="التقرير"><span class="badge <%=v.report_approved?'text-bg-success':'text-bg-light'%>"><%=v.report_approved?'تم اعتماده':'غير معتمد'%></span></td>
<td data-label="الإجراءات"><% if(v.report_approved){ %><a class="btn btn-sm btn-outline-primary" href="/clinic/doctor-report?visit_id=<%= v.visit_id %>">عرض التقرير المعتمد</a><% }else{ %>—<% } %></td></tr>
<% }} %></tbody>
</table>
</div>
<div class="small text-secondary mt-3">
<i class="bi bi-shield-lock ms-1"></i>
                إنشاء وتعديل التقرير الطبي من صلاحيات الطبيب فقط، والعيادة تعرضه
                للقراءة.
              </div>
</div>
</div>
<div class="col-lg-4">
<div class="soft-card p-4 mb-4">
<h5 class="fw-bold">معلومات المريض</h5>
<div class="d-flex justify-content-between py-2">
<span>تاريخ الميلاد</span><strong><%=patient.dob%></strong>
</div>
<div class="d-flex justify-content-between py-2">
<span>الجنس</span><strong><%=patient.genderLabel || 'غير محدد'%></strong>
</div>
<div class="d-flex justify-content-between py-2">
<span>عدد الزيارات</span><strong><%=patient.visits.length%></strong>
</div>
</div>
<div class="soft-card p-4">
<h5 class="fw-bold">المالية</h5>
<div class="d-flex justify-content-between py-2">
<span>إجمالي الفواتير</span><strong><%=patient.bill.total.toFixed(2)%> ₪</strong>
</div>
<div class="d-flex justify-content-between py-2">
<span>المتبقي</span><strong class="text-danger"><%=patient.bill.remaining.toFixed(2)%> ₪</strong>
</div>
<a class="btn btn-outline-primary w-100 mt-3" href="invoices">عرض الفواتير</a>
</div>
</div>
</div>
<div class="soft-card p-4 mb-4" id="treatment-plan-summary">
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
 <div><h4 class="fw-bold mb-1">خطة العلاج — عرض ومتابعة</h4>
 <div class="small text-secondary">الخطط التي أُنشئت داخل هذه العيادة فقط، والتعديل من صلاحية الطبيب.</div></div>
</div>
<% if(!patient.plans.length){ %><div class="text-secondary">لا توجد خطط علاج مسجلة لهذا المريض في العيادة.</div><% }else{ %>
<% for(const plan of patient.plans){ %>
<div class="readonly-note mb-3"><div class="d-flex justify-content-between gap-2 flex-wrap">
<strong><%=plan.name%></strong><span class="badge text-bg-primary"><%=plan.status%></span></div>
<div class="small text-secondary mt-2">الطبيب المسؤول: <%=plan.doctor%> • بدأت: <%=plan.start%> • التكلفة التقديرية: <%=plan.cost||'غير محددة'%> ₪</div>
<a class="btn btn-sm btn-outline-primary mt-2" href="/clinic/treatment-plan-details?id=<%= plan.id %>">عرض تفاصيل الخطة</a>
</div><% } %><% } %>
</div>
</section>
</main>
<%- include('../partials/clinic/footer') %>
<div class="toast-container position-fixed bottom-0 start-0 p-3">
<div class="toast align-items-center text-bg-primary border-0" id="appToast">
<div class="d-flex">
<div class="toast-body">تمت العملية</div>
<button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
</div>
</div>
</div>
<script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>

<!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button></body></html>